{
  "name": "dreamble-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run validate:content && astro dev",
    "validate:content": "node scripts/validate-content.mjs",
    "check": "npm run validate:content && astro check",
    "build": "npm run validate:content && astro build",
    "verify": "npm run check && npm test && astro build",
    "preview": "astro preview",
    "test": "node --test",
    "import": "node scripts/import-wechat.mjs",
    "publish": "bash scripts/publish.sh",
    "stats:setup": "bash scripts/setup-stats.sh",
    "stats:credentials": "node scripts/stats-config.mjs show-credentials",
    "stats:rotate-password": "node scripts/stats-config.mjs rotate-credentials && bash scripts/setup-stats.sh"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@fontsource/noto-serif-sc": "^5.0.8",
    "astro": "^7.1.0",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "marked": "^18.0.7",
    "marked-highlight": "^2.2.4",
    "marked-katex-extension": "^5.1.10"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "cheerio": "^1.2.0",
    "turndown": "^7.2.4",
    "typescript": "^5.9.3"
  }
}
