# ==========================================
# AI Agents & CLI Tools (Local State/Logs)
# ==========================================
# 这些条目在旧版本里曾以 symlink 形式被跟踪，现统一忽略。
# 一律写「不带斜杠」的形式：带斜杠的写法只匹配目录，匹配不到 symlink。
.agents
.agents/
**/.agents/
.workbuddy
.workbuddy/
**/.workbuddy/
.claude
.claude/
**/.claude/
.codebuddy
.codebuddy/
**/.codebuddy/
.antigravitycli/
**/.antigravitycli/
.codegraph
.omo/

# ==========================================
# Editors & IDEs
# ==========================================
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

# ==========================================
# Environment & Secrets (Security First)
# ==========================================
.env
.env.local
.env.*.local
*.env
*.pem
*.key

# ==========================================
# Node.js (If web/scripts added later)
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Python (If automation scripts added later)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

temp/
tmp/

images/
outputs/
.superpowers/

